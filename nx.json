{
  "installation": {
    "version": "23.1.0",
    "plugins": {
      "@nx/eslint": "23.1.0",
      "@nx/jest": "23.1.0",
      "@nx/cypress": "23.1.0",
      "@nx/next": "23.1.0",
      "@nx/docker": "23.1.0",
      "@nx/gradle": "23.1.0"
    }
  },
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": {
          "name": "docker:build"
        },
        "runTarget": {
          "name": "docker:run"
        }
      }
    },
    {
      "plugin": "@nx/gradle",
      "options": {
        "testTargetName": "test",
        "classesTargetName": "classes",
        "buildTargetName": "build"
      }
    }
  ],
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/src/test/**/*"
    ]
  },
  "nxCloudId": "6a5f70bf2852b4f4f484a8d5"
}
